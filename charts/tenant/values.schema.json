{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "displayName", "ownerGroupId", "costCenter", "azure"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$"},
    "displayName": {"type": "string", "minLength": 1},
    "ownerGroupId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "costCenter": {"type": "string", "minLength": 1},
    "serviceAccounts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
    },
    "keyVault": {"type": "boolean"},
    "keyVaultIpRules": {"type": "array", "items": {"type": "string"}},
    "hostnames": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"}
    },
    "quota": {"type": "object", "additionalProperties": {"type": "string"}},
    "limitRange": {"type": "object"},
    "azure": {
      "type": "object",
      "required": ["tenantId", "workloadClientId"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1},
        "workloadClientId": {"type": "string", "minLength": 1},
        "keyVaultUri": {"type": "string"}
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "istioRevision": {"type": "string"},
        "gatewayNamespace": {"type": "string"},
        "podSecurity": {"enum": ["baseline", "restricted"]}
      }
    }
  }
}
